# Database (MySQL)
DATABASE_URL="mysql://ratemystaff:CHANGE_ME@127.0.0.1:3306/ratemystaff"

# Auth.js — generate with: npx auth secret  (or node crypto randomBytes)
AUTH_SECRET="CHANGE_ME"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# App
APP_URL="http://localhost:3000"

# Fingerspot push receiver (diisi saat integrasi mesin)
FINGERSPOT_WEBHOOK_SECRET=""

# Scheduler tarik absensi otomatis (generate: node -e "console.log(require(\"crypto\").randomBytes(24).toString(\"hex\"))")
CRON_SECRET=""

# Integrasi Qendali POS (KPI karyawan: rating pelanggan, papan tugas, penjualan kasir), dua arah.
# Buktinya TIKET INTEGRASI qi1 dari qendali.com, diminta dengan QENDALI_LISENSI_TOKEN — tidak ada
# kunci bersama yang perlu diisi. Kosongkan POSPRO_API_URL untuk mematikan arah keluar.
POSPRO_API_URL="http://127.0.0.1:3001"

# Kunci API LAMA (POSPRO_API_KEY keluar, HR_API_KEY untuk /api/integrations/* masuk) DIABAIKAN
# kecuali jalan mundur di bawah dinyalakan. Biarkan kosong / hapus dari .env.
# QENDALI_INTEGRASI_KUNCI_LAMA="true"   # HANYA kalau qendali.com tidak bisa menerbitkan tiket
# POSPRO_API_KEY=""
# HR_API_KEY=""
