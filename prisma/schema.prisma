generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  EVALUATOR
  OWNER
}

enum AssessmentStatus {
  draft
  completed
  approved
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum RedemptionStatus {
  pending
  approved
  rejected
  delivered
  cancelled
}

enum RewardType {
  cash
  product
  voucher
}

enum OvertimeType {
  flat
  hourly
  hybrid
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String
  role          Role      @default(EVALUATOR)
  isActive      Boolean   @default(true)
  rememberToken String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assessments         Assessment[]      @relation("Evaluator")
  auditLogs           AuditLog[]
  notifications       Notification[]
  leaveDecisions      LeaveRequest[]    @relation("LeaveDecider")
  redemptionDecisions PointRedemption[] @relation("RedemptionDecider")
  lemburDecisions     PengajuanLembur[] @relation("LemburDecider")
  reimburseDecisions  Reimbursement[]   @relation("ReimburseDecider")
  absenHpDecisions    AbsenHpBukti[]    @relation("AbsenHpDecider")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  employees Employee[]
}

model Position {
  id           Int      @id @default(autoincrement())
  name         String
  departmentId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]

  @@index([departmentId])
}

model WorkSchedule {
  id                   Int       @id @default(autoincrement())
  name                 String
  startTime            String?
  endTime              String?
  breakStartTime       String?
  breakEndTime         String?
  lateToleranceMinutes Int       @default(15)
  dailyWage            Decimal   @default(0) @db.Decimal(15, 2)
  weeklyWage           Decimal   @default(0) @db.Decimal(15, 2)
  monthlyWage          Decimal   @default(0) @db.Decimal(15, 2)
  holidayWage          Decimal   @default(0) @db.Decimal(15, 2)
  overtimeWagePerHour  Decimal   @default(0) @db.Decimal(15, 2)
  isHoliday            Boolean   @default(false)
  // Mode "jam masuk bebas": lembur dari durasi kerja (8 jam) + uang makan (>10 jam), bukan shift jam-dinding.
  flexibleHours        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  employees   Employee[]
  jadwalShift JadwalShift[]
}

model Employee {
  id                 Int       @id @default(autoincrement())
  employeeCode       String    @unique @db.VarChar(20)
  machinePin         String?   @unique @db.VarChar(50)
  publicToken        String?   @unique @db.VarChar(36)
  fullName           String    @db.VarChar(150)
  nickname           String?   @db.VarChar(50)
  departmentId       Int?
  positionId         Int?
  workScheduleId     Int?
  photoPath          String?   @db.VarChar(255)
  joinDate           DateTime?
  salary             Decimal?  @db.Decimal(15, 2)
  email              String?
  phone              String?
  isActive           Boolean   @default(true)
  // Portal karyawan (/me/[token]): hash bcrypt PIN. Null = PIN belum dibuat.
  portalPin          String?   @db.VarChar(100)
  portalPinSetAt     DateTime?
  // Pemetaan ke akun PosPro (User.id di sana) untuk menarik KPI kinerja.
  // Null = belum dipetakan; KPI PosPro tidak ditampilkan untuk karyawan ini.
  posproUserId       Int?      @unique
  // Absen lewat HP (add-on hr.absen_hp): dinyalakan owner PER KARYAWAN. Perangkat = sidik
  // (sha256) id acak yang disimpan HP pertama yang dipakai — HP lain ditolak sampai owner
  // melepasnya. Yang disimpan cuma sidiknya, jadi isi basis data tidak bisa dipakai menyamar.
  absenHp            Boolean   @default(false)
  absenHpPerangkat   String?   @db.VarChar(64)
  absenHpPerangkatAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  department           Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?              @relation(fields: [positionId], references: [id], onDelete: SetNull)
  workSchedule         WorkSchedule?          @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  assessments          Assessment[]
  attendances          Attendance[]
  enrollments          MachineEnrollment[]
  leaveRequests        LeaveRequest[]
  pointEntries         PointEntry[]
  pointRedemptions     PointRedemption[]
  absenHpBukti         AbsenHpBukti[]
  peminjamanInventaris PeminjamanInventaris[]
  pengajuanLembur      PengajuanLembur[]
  jadwalShift          JadwalShift[]
  reimbursement        Reimbursement[]
  kunjunganKlien       KunjunganKlien[]
  timesheetEntri       TimesheetEntri[]

  @@index([isActive])
}

// Lokasi tempat karyawan boleh absen lewat HP (toko, gudang, lokasi event). Absen diterima
// kalau HP berada dalam `radiusM` dari titik ini. `wajibQr` = HP juga harus memindai QR yang
// berganti di layar lokasi itu (/absen-layar/<layarToken>); kodenya HMAC(qrRahasia, slot waktu).
model AbsenLokasi {
  id         Int      @id @default(autoincrement())
  nama       String   @db.VarChar(100)
  lat        Float
  lng        Float
  radiusM    Int      @default(100)
  wajibQr    Boolean  @default(false)
  qrRahasia  String   @db.VarChar(64)
  layarToken String   @unique @db.VarChar(36)
  aktif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bukti AbsenHpBukti[]
}

// Bukti satu absen lewat HP: foto, posisi, jarak ke lokasi, perangkat, dan apakah QR dipindai.
// Disimpan TERPISAH dari Attendance supaya baris absensi tetap berbentuk sama dengan scan mesin.
model AbsenHpBukti {
  id               Int       @id @default(autoincrement())
  attendanceId     Int?      @unique
  employeeId       Int
  lokasiId         Int?
  lat              Float
  lng              Float
  akurasiM         Int
  jarakM           Int
  fotoPath         String    @db.VarChar(255)
  perangkat        String    @db.VarChar(64)
  qr               Boolean   @default(false)
  ip               String?   @db.VarChar(64)
  // diterima | menunggu | ditolak. "menunggu" = absen di luar radius lokasi yang DIAJUKAN
  // karyawan; attendanceId baru terisi saat owner menyetujuinya.
  status           String    @default("diterima") @db.VarChar(20)
  alasan           String?   @db.Text
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?   @db.Text
  createdAt        DateTime  @default(now())

  employee  Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lokasi    AbsenLokasi? @relation(fields: [lokasiId], references: [id], onDelete: SetNull)
  decidedBy User?        @relation("AbsenHpDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([status])
}

// Mesin absensi fisik (per cabang). Dikenali dari SN (dev_id) yang dikirim mesin.
model Machine {
  id                  Int       @id @default(autoincrement())
  sn                  String    @unique @db.VarChar(100)
  name                String    @db.VarChar(100)
  mode                String    @default("cloud") @db.VarChar(20) // "cloud" (push) | "lan" (tarik IP)
  ip                  String?   @db.VarChar(64)
  port                Int?
  autoPull            Boolean   @default(false) // mode LAN: tarik otomatis terjadwal
  pullIntervalMinutes Int       @default(15)
  lastSeenAt          DateTime?
  // Alamat (Host) & IP publik yang dipakai mesin pada kontak terakhirnya — untuk "Info Mesin":
  // tahu mesin sudah memakai alamat baru atau masih alamat lama, dan dari toko mana.
  lastHost            String?   @db.VarChar(255)
  lastIp              String?   @db.VarChar(64)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  enrollments MachineEnrollment[]
  attendances Attendance[]
}

// Pemetaan PIN mesin → karyawan, per MESIN. PIN unik per mesin (bukan global),
// sehingga dua cabang boleh memakai PIN yang sama untuk orang berbeda.
model MachineEnrollment {
  id         Int      @id @default(autoincrement())
  machineId  Int
  pin        String   @db.VarChar(50)
  employeeId Int
  deviceName String?  @db.VarChar(150)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  machine  Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([machineId, pin])
  @@index([employeeId])
}

model AssessmentTemplate {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  description    String?  @db.Text
  departmentType String?  @db.VarChar(50)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  indicators  AssessmentIndicator[]
  assessments Assessment[]

  @@index([isActive])
}

model AssessmentIndicator {
  id          Int      @id @default(autoincrement())
  templateId  Int
  category    String   @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  weight      Decimal  @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scores   AssessmentScore[]

  @@index([templateId])
}

model Assessment {
  id              Int              @id @default(autoincrement())
  employeeId      Int
  templateId      Int
  evaluatorId     Int?
  isPublic        Boolean          @default(false)
  assessmentDate  DateTime
  period          String?
  totalScore      Decimal?         @db.Decimal(5, 2)
  grade           String?          @db.VarChar(20)
  raterName       String?
  evaluatorNotes  String?          @db.Text
  developmentPlan String?          @db.Text
  recommendation  String?          @db.Text
  status          AssessmentStatus @default(draft)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template  AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  evaluator User?              @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)
  scores    AssessmentScore[]

  @@index([employeeId])
  @@index([templateId])
  @@index([evaluatorId])
  @@index([assessmentDate])
  @@index([status])
}

model AssessmentScore {
  id            Int      @id @default(autoincrement())
  assessmentId  Int
  indicatorId   Int
  score         Int
  weightedValue Decimal  @db.Decimal(5, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  indicator  AssessmentIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([indicatorId])
}

model OvertimeCategory {
  id             Int          @id @default(autoincrement())
  name           String
  type           OvertimeType @default(hourly)
  rate           Decimal      @default(0) @db.Decimal(10, 2)
  companyContext String       @default("default")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendances Attendance[]
}

model Attendance {
  id                      Int      @id @default(autoincrement())
  employeeId              Int
  scanDate                DateTime
  scanType                String?  @db.VarChar(20)
  machineName             String?  @db.VarChar(100)
  snMachine               String?  @db.VarChar(100)
  machineId               Int?
  status                  String   @default("on_time") @db.VarChar(20)
  absenceReason           String?  @db.Text
  lateMinutes             Int      @default(0)
  overtimeMinutes         Int      @default(0)
  overtimeReason          String?  @db.Text
  overtimeCategoryId      Int?
  approvedOvertimeMinutes Int      @default(0)
  overtimeAmount          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  overtimeCategory OvertimeCategory? @relation(fields: [overtimeCategoryId], references: [id], onDelete: SetNull)
  machine          Machine?          @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([scanDate])
  @@index([status])
  @@index([machineId])
}

// Pengajuan izin/sakit/cuti. Baru menyentuh Attendance SETELAH disetujui owner/manajemen.
model LeaveRequest {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  startDate    DateTime
  endDate      DateTime
  type         String      @db.VarChar(20) // "Izin" | "Sakit" | "Cuti"
  reason       String      @db.Text
  status       LeaveStatus @default(pending)
  // "portal" (halaman karyawan) | "link" (form publik) | "admin"
  source       String      @default("portal") @db.VarChar(20)
  decidedById  Int?
  decidedAt    DateTime?
  decisionNote String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

// Poin harian karyawan — hasil hitungan dari omzet, pekerjaan, task & kehadiran.
// Disimpan (bukan dihitung ulang tiap buka halaman) supaya saldo poin murah dihitung
// dan riwayatnya tidak berubah walau tarif poin kelak diubah.
model PointEntry {
  id               Int      @id @default(autoincrement())
  employeeId       Int
  date             DateTime
  /**
   * Omzet hari itu (kasir + desain + produksi) — disimpan untuk penjelasan.
   */
  omzet            Decimal  @default(0) @db.Decimal(15, 2)
  omzetPoints      Int      @default(0)
  jobPoints        Int      @default(0)
  taskPoints       Int      @default(0)
  attendancePoints Int      @default(0)
  points           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
}

// Katalog hadiah yang bisa ditukar dengan poin.
model Reward {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(150)
  description String?    @db.Text
  type        RewardType @default(product)
  pointCost   Int
  /**
   * Nilai rupiah untuk hadiah uang; hanya informasi untuk jenis lain.
   */
  cashValue   Decimal?   @db.Decimal(15, 2)
  /**
   * null = tidak dibatasi.
   */
  stock       Int?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  redemptions PointRedemption[]

  @@index([isActive])
}

// Pengajuan penukaran poin oleh karyawan; poin baru terpotong setelah disetujui.
model PointRedemption {
  id           Int              @id @default(autoincrement())
  employeeId   Int
  rewardId     Int?
  /**
   * Nama & harga poin disalin saat mengajukan agar riwayat tak berubah.
   */
  rewardName   String           @db.VarChar(150)
  pointCost    Int
  status       RedemptionStatus @default(pending)
  note         String?          @db.Text
  decisionNote String?          @db.Text
  decidedById  Int?
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reward    Reward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  decidedBy User?    @relation("RedemptionDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeaveLink {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String   @db.VarChar(50)
  targetTable String   @db.VarChar(50)
  targetId    Int?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([targetTable])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    Int
  type      String
  data      Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
}

// Pondasi "cloud mesin absensi": raw push log dari mesin Fingerspot
model FingerspotRawLog {
  id        Int       @id @default(autoincrement())
  snMachine String?   @db.VarChar(100)
  pin       String?   @db.VarChar(50)
  scanAt    DateTime?
  rawBody   Json
  processed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([processed])
  @@index([snMachine])
}

// Tiket masuk `qm1` yang sudah dipakai (lib/lisensi/tiket-masuk.ts): jti sekali pakai, disimpan
// sampai tiketnya kedaluwarsa supaya tautan yang sama tidak bisa dipakai dua kali.
model TiketMasukTerpakai {
  jti             String   @id @db.VarChar(64)
  kedaluwarsaPada DateTime
  createdAt       DateTime @default(now())

  @@index([kedaluwarsaPada])
}

// Inventaris kantor: barang milik usaha yang dipinjamkan ke karyawan (seragam, laptop, kunci,
// kartu ID). `jumlah` = seluruh unit yang dimiliki; `rusakHilang` = unit yang tidak bisa dipakai
// lagi. Unit dipegang dihitung dari peminjaman yang belum kembali, jadi tidak disimpan dua kali.
model InventarisKantor {
  id          Int      @id @default(autoincrement())
  nama        String   @db.VarChar(150)
  // seragam | laptop | kunci | kartu_id | elektronik | lainnya
  kategori    String   @default("lainnya") @db.VarChar(30)
  keterangan  String?  @db.VarChar(500)
  jumlah      Int      @default(1)
  rusakHilang Int      @default(0)
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  peminjaman PeminjamanInventaris[]

  @@index([aktif])
}

// Satu kali barang dipegang karyawan. Kembali = `dikembalikanPada` terisi; `kondisiKembali`
// rusak/hilang menambah `InventarisKantor.rusakHilang` sebanyak `jumlah`.
model PeminjamanInventaris {
  id               Int       @id @default(autoincrement())
  inventarisId     Int
  employeeId       Int
  jumlah           Int       @default(1)
  dipinjamPada     DateTime  @default(now())
  dikembalikanPada DateTime?
  // baik | rusak | hilang
  kondisiKembali   String?   @db.VarChar(20)
  catatan          String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventaris InventarisKantor @relation(fields: [inventarisId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([inventarisId, dikembalikanPada])
  @@index([employeeId])
}

// ── Paritas Hadirr (18 Okt 2026) ────────────────────────────────────────────────────────────
// Tanggal disimpan sebagai DateTime tengah malam LOKAL ("YYYY-MM-DDT00:00:00"), sama dengan
// LeaveRequest — bukan @db.Date, supaya satu konvensi tanggal untuk seluruh modul absensi.

// Pengajuan lembur dari karyawan (hr.overtime). Menit lembur yang DIBAYAR tetap
// Attendance.approvedOvertimeMinutes — itu yang dibaca struk lembur; pengajuan yang disetujui
// menulis ke sana, jadi tidak ada dua sumber untuk satu angka.
model PengajuanLembur {
  id               Int         @id @default(autoincrement())
  employeeId       Int
  tanggal          DateTime
  mulai            String?     @db.VarChar(5)
  selesai          String?     @db.VarChar(5)
  menit            Int
  alasan           String      @db.Text
  status           LeaveStatus @default(pending)
  // "portal" | "link" | "admin"
  sumber           String      @default("portal") @db.VarChar(20)
  menitDisetujui   Int?
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("LemburDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, tanggal])
  @@index([status])
}

// Jadwal shift PER TANGGAL (hr.schedule). Kalau ada baris untuk (karyawan, tanggal), dia
// MENGALAHKAN Employee.workScheduleId untuk hari itu. libur = true → hari itu libur karyawan
// itu (bukan libur nasional), workScheduleId diabaikan.
model JadwalShift {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  tanggal        DateTime
  workScheduleId Int?
  libur          Boolean  @default(false)
  catatan        String?  @db.VarChar(255)
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)

  @@unique([employeeId, tanggal])
  @@index([tanggal])
}

// Klaim penggantian biaya (hr.reimbursement). status: menunggu | disetujui | ditolak | dibayar.
model Reimbursement {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  tanggal          DateTime
  // transport | makan | bensin | parkir | belanja | lainnya
  kategori         String    @default("lainnya") @db.VarChar(30)
  jumlah           Decimal   @db.Decimal(15, 2)
  keterangan       String    @db.Text
  fotoPath         String?   @db.VarChar(255)
  status           String    @default("menunggu") @db.VarChar(20)
  jumlahDisetujui  Decimal?  @db.Decimal(15, 2)
  sumber           String    @default("portal") @db.VarChar(20)
  decidedById      Int?
  decidedAt        DateTime?
  catatanKeputusan String?   @db.Text
  dibayarAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("ReimburseDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, tanggal])
  @@index([status])
}

// Kunjungan ke klien (hr.visits): check-in di lokasi klien (GPS + foto), check-out + hasil.
// Bukan absensi — tidak menyentuh Attendance.
model KunjunganKlien {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  namaKlien      String    @db.VarChar(150)
  alamat         String?   @db.VarChar(255)
  tujuan         String?   @db.VarChar(255)
  masukAt        DateTime
  masukLat       Float
  masukLng       Float
  masukAkurasiM  Int
  masukFoto      String?   @db.VarChar(255)
  keluarAt       DateTime?
  keluarLat      Float?
  keluarLng      Float?
  keluarAkurasiM Int?
  // tertarik | deal | follow_up | tidak_tertarik | lainnya
  hasil          String?   @db.VarChar(30)
  catatan        String?   @db.Text
  ip             String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, masukAt])
  @@index([masukAt])
}

// Catatan pekerjaan per rentang jam (hr.timesheet).
model TimesheetEntri {
  id         Int      @id @default(autoincrement())
  employeeId Int
  tanggal    DateTime
  mulai      String   @db.VarChar(5)
  selesai    String   @db.VarChar(5)
  menit      Int
  proyek     String   @db.VarChar(100)
  kegiatan   String   @db.VarChar(255)
  catatan    String?  @db.Text
  sumber     String   @default("portal") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, tanggal])
  @@index([proyek])
}
